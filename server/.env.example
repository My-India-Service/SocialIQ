PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/voxa
JWT_SECRET=change-me-to-a-long-random-string
CLIENT_URL=http://localhost:5173
SERVER_URL=http://localhost:5000

# Google Cloud OAuth (YouTube Data API v3)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/connections/youtube/callback

# Meta / Facebook App (Instagram + Facebook Page comments)
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:5000/api/connections/meta/callback

# OpenAI for LLM intent categorization (optional — falls back to rules)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Daily report email (e.g. Gmail App Password, SendGrid, Mailgun SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
REPORT_FROM=Voxa <reports@voxa.app>
