# Must match client Vite proxy (client/vite.config.js defaults to :5001; override with VITE_API_PROXY).
PORT=5001
MONGODB_URI=mongodb://127.0.0.1:27017/voxa
JWT_SECRET=change-me-to-a-long-random-string
# Comma-separated allowed. On Render production, put the live HTTPS client FIRST
# (or only the live URL). OAuth callbacks prefer https non-localhost in production.
# CLIENT_URL=https://socialiq-client.onrender.com
# Local:
CLIENT_URL=http://localhost:5173
SERVER_URL=http://localhost:5001

# Google Cloud OAuth (YouTube Data API v3)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5001/api/connections/youtube/callback

# Meta / Facebook App (Facebook Login — Page comments)
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:5001/api/connections/meta/callback

# Instagram Login (Business Login for Instagram)
# Copy from Meta Dashboard → Instagram → API setup with Instagram login.
# Often DIFFERENT from META_APP_ID (e.g. 1102250409082500 vs 1645663120309703).
# If omitted, server falls back to META_APP_ID — only works when IDs are identical.
META_INSTAGRAM_APP_ID=
META_INSTAGRAM_APP_SECRET=
META_INSTAGRAM_REDIRECT_URI=http://localhost:5001/api/connections/instagram/callback

# Meta WhatsApp Cloud API (server-side only — never expose to React)
# There is NO separate WHATSAPP_CALLBACK_URL env.
# Meta Callback URL = {SERVER_URL}/api/whatsapp/webhook
# Render: set SERVER_URL=https://YOUR-API.onrender.com (origin only)
# and META_WEBHOOK_VERIFY_TOKEN to the same string you enter in Meta Verify token.
META_WHATSAPP_ACCESS_TOKEN=
META_WABA_ID=
META_PHONE_NUMBER_ID=
META_WEBHOOK_VERIFY_TOKEN=
META_GRAPH_API_VERSION=v21.0
# Optional approved template name for outbound leads outside the 24h session window
META_WHATSAPP_LEAD_TEMPLATE=
META_WHATSAPP_LEAD_TEMPLATE_LANG=en

# OpenAI for LLM intent categorization (optional — falls back to rules)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Daily report email (e.g. Gmail App Password, SendGrid, Mailgun SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
REPORT_FROM=Voxa <reports@voxa.app>
