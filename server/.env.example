# Must match client Vite proxy (client/vite.config.js defaults to :5001; override with VITE_API_PROXY).
PORT=5001
MONGODB_URI=mongodb://127.0.0.1:27017/voxa
JWT_SECRET=change-me-to-a-long-random-string
# Comma-separated allowed. On Render production, put the live HTTPS client FIRST
# (or only the live URL). OAuth callbacks prefer https non-localhost in production.
# Production (Render direct URL — no trailing slash):
# CLIENT_URL=https://www.socialaidigital.com,https://socialaidigital.com
# SERVER_URL=https://socialiq-37aa.onrender.com
# GOOGLE_REDIRECT_URI=https://socialiq-37aa.onrender.com/api/connections/youtube/callback
# META_REDIRECT_URI=https://socialiq-37aa.onrender.com/api/connections/meta/callback
# META_INSTAGRAM_REDIRECT_URI=https://socialiq-37aa.onrender.com/api/connections/instagram/callback
# LINKEDIN_REDIRECT_URI=https://socialiq-37aa.onrender.com/api/connections/linkedin/callback
# TIKTOK_REDIRECT_URI=https://socialiq-37aa.onrender.com/api/connections/tiktok/callback
# Static site (build-time): VITE_API_URL=https://socialiq-37aa.onrender.com
# Optional custom API domain (instead of Render URL): https://api.socialaidigital.com
# Local:
CLIENT_URL=http://localhost:5173
SERVER_URL=http://localhost:5001

# Google Cloud OAuth (YouTube Data API v3)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5001/api/connections/youtube/callback

# Meta / Facebook App (Facebook Login — Page comments)
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:5001/api/connections/meta/callback

# Instagram Login (Business Login for Instagram)
# Copy from Meta Dashboard → Instagram → API setup with Instagram login.
# Often DIFFERENT from META_APP_ID (e.g. 1102250409082500 vs 1645663120309703).
# If omitted, server falls back to META_APP_ID — only works when IDs are identical.
META_INSTAGRAM_APP_ID=
META_INSTAGRAM_APP_SECRET=
META_INSTAGRAM_REDIRECT_URI=http://localhost:5001/api/connections/instagram/callback

# LinkedIn — Sign In (OpenID) + Share on LinkedIn on this app.
# https://www.linkedin.com/developers/apps
# Default scopes: openid profile email w_member_social
# After a separate Community Management API app is approved, override:
# LINKEDIN_OAUTH_SCOPES=openid,profile,email,rw_organization_admin,r_organization_social,w_organization_social
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:5001/api/connections/linkedin/callback
# LINKEDIN_OAUTH_SCOPES=

# TikTok Login Kit (developers.tiktok.com — redirect URI must be HTTPS in production)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=http://localhost:5001/api/connections/tiktok/callback

# WhatsApp is hidden unless this is true (inbox, webhook, WhatsApp alerts). wa.me handoff links work either way.
WHATSAPP_ENABLED=false
# Meta WhatsApp Cloud API (server-side only — never expose to React)
# There is NO separate WHATSAPP_CALLBACK_URL env.
# Meta Callback URL = {SERVER_URL}/api/whatsapp/webhook
# Production: set SERVER_URL=https://socialiq-37aa.onrender.com (origin only)
# and META_WEBHOOK_VERIFY_TOKEN to the same string you enter in Meta Verify token.
META_WHATSAPP_ACCESS_TOKEN=
META_WABA_ID=
META_PHONE_NUMBER_ID=
META_WEBHOOK_VERIFY_TOKEN=
META_GRAPH_API_VERSION=v21.0
# Optional approved template name for outbound leads outside the 24h session window
META_WHATSAPP_LEAD_TEMPLATE=
META_WHATSAPP_LEAD_TEMPLATE_LANG=en

# OpenAI for LLM intent categorization (optional — falls back to rules)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Instagram Messaging (private reply / DM sales agent — requires Meta App Review)
# Set true after instagram_business_manage_messages is approved on your Meta app.
META_INSTAGRAM_MESSAGING_ENABLED=false
# Verify token for Instagram messaging webhook (GET /api/instagram/webhook)
META_INSTAGRAM_WEBHOOK_VERIFY_TOKEN=

# Stripe INR billing (optional — mock plan switch when unset)
STRIPE_SECRET_KEY=
STRIPE_PRICE_STARTER_INR=
STRIPE_PRICE_GROWTH_INR=
STRIPE_PRICE_BUSINESS_INR=

# Daily report + OTP verification emails (Gmail App Password, SendGrid, Mailgun SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
REPORT_FROM=SocialAiDigital <reports@voxa.app>
# Failure alerts (requires SMTP_* above). Defaults to myindiaservice1@gmail.com if unset.
ALERT_EMAIL=myindiaservice1@gmail.com
# Without SMTP in non-production, OTP codes are returned as devOtp and logged.

# Hourly crisis early-warning sweep (negative spikes + crisis keywords). Set false to disable.
CRISIS_MONITOR_ENABLED=true

# Comment-to-checkout. Without Razorpay keys, links fall back to a hosted UPI pay page
# ({SERVER_URL}/api/checkout/pay/:ref) using the brand's UPI ID from the Checkout page.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Razorpay Dashboard → Webhooks → {SERVER_URL}/api/checkout/razorpay/webhook, event payment_link.paid
RAZORPAY_WEBHOOK_SECRET=
