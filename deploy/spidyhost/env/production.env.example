# SocialAiDigital on Spidyhost (cPanel "Setup Node.js App", app root ~/socialiq).
# Save as ~/socialiq/server/.env (server/loadEnv.js reads it). Do not also set these keys in the panel: panel values win.
# One-time copy of secret values from the current ~/api/.env (or the old Render service). Never commit the real file.
# Do not set PORT: Passenger assigns it.

NODE_ENV=production

MONGODB_URI=
JWT_SECRET=

CLIENT_URL=https://www.socialaidigital.com,https://socialaidigital.com
SERVER_URL=https://www.socialaidigital.com
# Bare domain redirects 301 to this host (API paths excluded).
CANONICAL_HOST=www.socialaidigital.com

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://www.socialaidigital.com/api/connections/youtube/callback
GOOGLE_LOGIN_REDIRECT_URI=https://www.socialaidigital.com/api/auth/google/callback

META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=https://www.socialaidigital.com/api/connections/meta/callback
META_INSTAGRAM_APP_ID=
META_INSTAGRAM_APP_SECRET=
META_INSTAGRAM_REDIRECT_URI=https://www.socialaidigital.com/api/connections/instagram/callback
META_GRAPH_API_VERSION=v21.0
META_INSTAGRAM_MESSAGING_ENABLED=false
META_INSTAGRAM_WEBHOOK_VERIFY_TOKEN=

LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=https://www.socialaidigital.com/api/connections/linkedin/callback
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=https://www.socialaidigital.com/api/connections/tiktok/callback

WHATSAPP_ENABLED=false
META_WEBHOOK_VERIFY_TOKEN=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
REPORT_FROM=SocialAiDigital <reports@socialaidigital.com>
ALERT_EMAIL=myindiaservice1@gmail.com
# Turn on after a test email is delivered from this host.
EMAIL_OTP_ENABLED=false

ADMIN_EMAIL=
ADMIN_PASSWORD=

# false until DNS points here (the old host still runs it); set true on cutover day.
CRISIS_MONITOR_ENABLED=false

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
